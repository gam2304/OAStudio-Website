 Copy to .env and fill in. Never commit .env.

# PostgreSQL (used by docker-compose.yml and the Spring Boot app)
DB_USERNAME=oastudio
DB_PASSWORD=change-me

# Spring Boot
SERVER_PORT=9001
FRONTEND_ORIGIN=http://localhost:5173

# Initial administrator, created on first startup only if no admin exists
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# Cloudinary (server-side only; never expose in frontend code)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

